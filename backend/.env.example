DEBUG=True
SECRET_KEY=django-insecure-taxonomy-classifier-prod-key-2026-xyz

# Database Configuration (MariaDB / MySQL primary)
DB_ENGINE=mariadb
DB_NAME=taxonomy_db
DB_USER=root
DB_PASSWORD=rootpassword
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis / Celery Broker
REDIS_URL=redis://127.0.0.1:6379/0

# Taxonomy Version
TAXONOMY_VERSION=2026-08

# AI Classification Provider ('hybrid_heuristic', 'gemini', 'openai', 'anthropic')
CLASSIFIER_PROVIDER=hybrid_heuristic

# API Credentials & Model
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Batch & Worker Tuning
CLASSIFICATION_BATCH_SIZE=50
MAX_AI_CONCURRENCY=10
MAX_RETRIES=3

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
